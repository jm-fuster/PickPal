# ============================================================
# Clerk — autenticación
# Crea (gratis) una app en https://agenda.clerk.com.
# Las claves empiezan por pk_test_ / sk_test_ en development y
# pk_live_ / sk_live_ en production.
# ============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Rutas de Clerk (no toques; son las que usa el App Router de Next).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/agenda
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/agenda

# Issuer del JWT template "convex" en Clerk. Crea el template en
# Clerk dashboard → Configure → JWT Templates → "Convex" (preset).
# Copia el Issuer (URL tipo https://xxx.clerk.accounts.dev).
# Este valor también hay que ponerlo en Convex dashboard →
# Settings → Environment Variables, con el mismo nombre.
CLERK_JWT_ISSUER_DOMAIN=

# ============================================================
# Convex — backend reactivo y base de datos
# `npx convex dev` rellena estos dos automáticamente la primera vez.
# Si trabajas en producción, usa `npx convex deploy` y obtén el
# CONVEX_DEPLOY_KEY para Vercel.
# ============================================================
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# ============================================================
# Secreto compartido server-only que autoriza las mutations de
# cuota (api.recommendationUsage.reserve / refund) como llamadas
# desde la API route, no desde el navegador. Sin él un usuario
# autenticado podría llamar a `refund` directamente y saltarse el
# límite de 10 generaciones/día.
#
# Genera un valor aleatorio largo, p. ej.:  openssl rand -hex 32
# El MISMO valor debe estar en dos sitios:
#   - Next.js (este .env / Vercel env)
#   - Convex:  npx convex env set CONVEX_SERVER_SECRET <valor>
# No lleva prefijo NEXT_PUBLIC_ (jamás debe llegar al cliente).
# ============================================================
CONVEX_SERVER_SECRET=

# ============================================================
# Resend — envío de emails de notificación de cumpleaños
# Crea cuenta gratis en https://resend.com (3.000 emails/mes free).
# El dominio de envío verificado es `pickpal.jorgemolinafuster.com`.
# EMAIL_FROM va en formato `Nombre <dirección>`; el dominio debe estar
# verificado en Resend, pero la parte antes de la @ no necesita buzón
# real. Sin dominio verificado, el remitente sandbox de Resend
# (`onboarding@resend.dev`) solo entrega a la dirección con la que te
# registraste en Resend.
#
# Estas variables viven en el entorno de **Convex**, no en Next.js ni
# en Vercel (las consume el cron `internal.emails.runDailyEmailNotifications`).
# Ponerlas en Vercel no tiene ningún efecto.
# Configúralas con: `npx convex env set RESEND_API_KEY ... [--prod]`
#
# Además, el JWT template "convex" en Clerk debe incluir el claim
# `email`: Clerk Dashboard → JWT Templates → convex → editar el JSON
# y añadir `"email": "{{user.primary_email_address}}"`.
# ============================================================
RESEND_API_KEY=
EMAIL_FROM="PickPal <hola@pickpal.jorgemolinafuster.com>"

# ============================================================
# Google Gemini — recomendaciones de regalos con IA
# Saca una API key gratis en https://aistudio.google.com/app/apikey.
# Google ya no publica los límites del free tier por modelo en su doc:
# consulta los tuyos en https://aistudio.google.com/rate-limit (y avisa
# de que "no están garantizados"). De sobra para un proyecto personal
# con el rate limit que ya tiene /api/recommendations (10 gen/usuario/día).
# OJO: la cuota va por proyecto de Google Cloud, NO por API key. Si
# reutilizas el proyecto de otra app, comparten el mismo límite diario.
# ============================================================
GOOGLE_GENERATIVE_AI_API_KEY=

# ============================================================
# Pexels — fotos de stock para las ideas de regalo (opcional)
# Saca una API key gratis e instantánea en https://www.pexels.com/api/
# (200 peticiones/hora, 20.000/mes — de sobra: cada generación
# consume 9). Sin la key, las cards usan la cabecera de icono.
# ============================================================
PEXELS_API_KEY=

# ============================================================
# Brandfetch — tienda oficial (dominio + logo) de las marcas
# favoritas, para enlazar la card directamente a la tienda de la
# marca en vez de a un marketplace (opcional).
# Saca un clientId gratis en https://developers.brandfetch.com
# (Brand Search API gratuita; Logo API 500k req/mes). Lo consume
# /api/recommendations al generar ideas; el volumen queda acotado
# por la cuota de 10 generaciones/usuario/día. Sin la clave, la
# card cae al botón de búsqueda de marca en Google (Capa 0).
# No lleva prefijo NEXT_PUBLIC_ (es server-only).
# ============================================================
BRANDFETCH_CLIENT_ID=
